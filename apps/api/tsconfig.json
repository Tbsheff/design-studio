{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": "../..",
    "paths": {
      "@design-studio/actions": ["../../packages/common/actions/src/index.ts"],
      "@design-studio/actions/*": ["../../packages/common/actions/src/*"],
      "@design-studio/contracts": [
        "../../packages/common/contracts/src/contracts.ts"
      ],
      "@design-studio/contracts/*": ["../../packages/common/contracts/src/*"],
      "effect": ["../../node_modules/effect"],
      "effect/*": ["../../node_modules/effect/*"]
    }
  },
  "include": ["src"]
}
