{
  "name": "@design-studio/desktop",
  "version": "0.6.0",
  "private": true,
  "description": "A local AI design studio: an agent writes HTML and React files on disk, the studio previews and versions them.",
  "license": "Apache-2.0",
  "repository": "github:Tbsheff/design-studio",
  "type": "module",
  "main": "desktop/dist/main.js",
  "scripts": {
    "dev": "concurrently -k -n server,ui \"tsx watch src/server/index.ts\" \"vite --config vite.ui.config.ts\"",
    "start": "vite build --config vite.ui.config.ts && tsx src/server/index.ts",
    "server": "tsx src/server/index.ts",
    "setup:cloud": "pnpm --filter @design-studio/publish install --frozen-lockfile",
    "build:ui": "vite build --config vite.ui.config.ts",
    "typecheck": "tsc -b ../../tsconfig.json --pretty false",
    "typecheck:tsrs": "tsx scripts/typecheck-tsrs.ts",
    "typecheck:rs": "pnpm run typecheck:tsrs",
    "typecheck:rs:fast": "tsrs --noEmit --fast -p tsconfig.server.json",
    "typecheck:diff": "tsx scripts/typecheck-diff.ts",
    "lint": "cd ../.. && oxlint -c oxlint.fast.config.ts",
    "lint:slow": "cd ../.. && oxlint",
    "lint:types": "cd ../.. && oxlint --type-aware",
    "lint:boundaries": "cd ../.. && oxlint -c oxlint.boundaries.config.ts apps packages",
    "lint:gate": "tsx scripts/lint-gate.ts",
    "lint:day-one": "tsx ../../lint/gen-day-one.ts",
    "fix": "ultracite fix",
    "format": "cd ../.. && oxfmt",
    "format:check": "cd ../.. && oxfmt --check",
    "gen:routes": "tsx scripts/gen-routes.ts",
    "new:action": "tsx scripts/new-action.ts",
    "new:domain": "tsx scripts/new-domain.ts",
    "new:error": "tsx scripts/new-error.ts",
    "new:feature": "tsx scripts/new-feature.ts",
    "new:service": "tsx scripts/new-service.ts",
    "check:scripts": "tsx scripts/gen-routes.ts --check && tsx scripts/check-ownership.ts && tsx scripts/check-coarse.ts && tsx scripts/check-bridge-guards.ts && tsx scripts/check-actions.ts --probes && node scripts/check-tenant-boundary.mjs",
    "check:tenant": "node scripts/check-tenant-boundary.mjs",
    "typecheck:cloud": "pnpm --filter @design-studio/api run typecheck && pnpm run check:tenant",
    "check:actions": "tsx scripts/check-actions.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "check:clip": "tsx scripts/check-clip.ts",
    "check": "pnpm run lint:boundaries && pnpm run typecheck && pnpm run lint:gate && pnpm run check:scripts",
    "test": "vitest run",
    "e2e": "playwright test",
    "electron:dev": "tsx scripts/electron-dev.ts",
    "desktop:build": "tsx scripts/electron-dev.ts --build-only",
    "e2e:desktop": "pnpm run desktop:build && playwright test -c playwright.desktop.config.ts",
    "desktop:stage": "tsx desktop/build.ts",
    "desktop:pack": "tsx scripts/desktop-pack.ts",
    "render:parity": "pnpm run desktop:build && tsx scripts/render-parity.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.307",
    "@babel/parser": "^7.26.0",
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@design-studio/actions": "workspace:*",
    "@design-studio/contracts": "workspace:*",
    "@design-studio/ui": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.14.0",
    "chokidar": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "dictionary-en": "^4.0.0",
    "effect": "4.1.1",
    "electron-updater": "6.8.9",
    "esbuild": "0.28.2",
    "hono": "^4.6.0",
    "jszip": "^3.10.2",
    "magic-string": "^0.30.0",
    "nanoid": "^5.0.0",
    "nspell": "^2.1.5",
    "parse5": "^7.2.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.48.0",
    "pngjs": "^7.0.0",
    "polygon-clipping": "0.15.7",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "source-map-js": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "vite": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron/notarize": "2.5.0",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.0.0",
    "@types/nspell": "^2.1.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "dugite": "3.3.1",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "eslint": "10.14.0",
    "eslint-plugin-boundaries": "7.4.0",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-tsdoc": "0.5.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-plugin-react-doctor": "0.9.18",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "^4.3.3",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "tsx": "^4.19.0",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@6.0.3",
    "ultracite": "8.1.0",
    "vitest": "^3.0.0"
  }
}
