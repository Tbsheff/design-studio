{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuild/server.tsbuildinfo",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": [
    "src/server",
    "src/shared",
    "scripts",
    "e2e",
    "desktop/**/*.ts",
    "desktop/**/*.cts",
    "*.ts",
    "../../lint",
    "../../*.ts",
    "../../packages/common/actions/src",
    "../../packages/common/contracts/src"
  ],
  "exclude": ["scripts/stamp/probes", "src/server/templates", "desktop/dist"]
}
