{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuild/server.tsbuildinfo",
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/server",
    "src/shared",
    "scripts",
    "e2e",
    "lint",
    "desktop/**/*.ts",
    "desktop/**/*.cts",
    "*.ts"
  ],
  "exclude": ["scripts/stamp/probes", "src/server/templates", "desktop/dist"]
}
