{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuild/ui.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": [
    "src/ui",
    "src/shared",
    "../../packages/common/actions/src",
    "../../packages/common/contracts/src",
    "../../packages/ui/src"
  ],
  "exclude": ["src/ui/**/*.test.ts", "src/ui/**/*.test.tsx"]
}
