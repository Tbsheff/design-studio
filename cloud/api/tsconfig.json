{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": "../..",
    "paths": {
      "effect": ["../../node_modules/effect"],
      "effect/*": ["../../node_modules/effect/*"]
    }
  },
  "include": ["src", "../../src/shared/actions/_core"]
}
