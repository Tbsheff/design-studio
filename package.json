{
  "name": "design-studio",
  "version": "0.6.0",
  "private": true,
  "description": "A local AI design studio: an agent writes HTML and React files on disk, the studio previews and versions them.",
  "license": "Apache-2.0",
  "repository": "github:Tbsheff/design-studio",
  "type": "module",
  "main": "desktop/dist/main.js",
  "scripts": {
    "dev": "concurrently -k -n server,ui \"tsx watch src/server/index.ts\" \"vite --config vite.ui.config.ts\"",
    "start": "vite build --config vite.ui.config.ts && tsx src/server/index.ts",
    "server": "tsx src/server/index.ts",
    "setup:cloud": "pnpm --dir cloud/publish-worker install --frozen-lockfile",
    "build:ui": "vite build --config vite.ui.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tsrs": "tsrs --noEmit -p tsconfig.json",
    "typecheck:rs": "pnpm run typecheck:tsrs",
    "typecheck:rs:fast": "tsrs --noEmit --fast -p tsconfig.json",
    "typecheck:diff": "tsx scripts/typecheck-diff.ts",
    "lint": "oxlint -c oxlint.fast.config.ts",
    "lint:slow": "oxlint",
    "lint:types": "oxlint --type-aware",
    "lint:boundaries": "oxlint -c oxlint.boundaries.config.ts src desktop scripts e2e cloud",
    "lint:gate": "tsx scripts/lint-gate.ts",
    "lint:day-one": "tsx lint/gen-day-one.ts",
    "fix": "ultracite fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "gen:routes": "tsx scripts/gen-routes.ts",
    "new:action": "tsx scripts/new-action.ts",
    "new:domain": "tsx scripts/new-domain.ts",
    "new:error": "tsx scripts/new-error.ts",
    "new:feature": "tsx scripts/new-feature.ts",
    "new:service": "tsx scripts/new-service.ts",
    "check:scripts": "tsx scripts/gen-routes.ts --check && tsx scripts/check-ownership.ts && tsx scripts/check-coarse.ts && tsx scripts/check-bridge-guards.ts && tsx scripts/check-actions.ts",
    "check:actions": "tsx scripts/check-actions.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "check": "pnpm run lint:boundaries && pnpm run typecheck && pnpm run lint:gate && pnpm run check:scripts",
    "test": "vitest run",
    "e2e": "playwright test",
    "electron:dev": "tsx scripts/electron-dev.ts",
    "desktop:build": "tsx scripts/electron-dev.ts --build-only",
    "e2e:desktop": "pnpm run desktop:build && playwright test -c playwright.desktop.config.ts",
    "desktop:stage": "tsx desktop/build.ts",
    "desktop:pack": "tsx scripts/desktop-pack.ts",
    "render:parity": "pnpm run desktop:build && tsx scripts/render-parity.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.307",
    "@babel/parser": "^7.26.0",
    "@base-ui/react": "^1.9.0",
    "@hono/node-server": "^1.13.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.14.0",
    "chokidar": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "effect": "4.1.1",
    "electron-updater": "6.8.9",
    "esbuild": "0.28.2",
    "hono": "^4.6.0",
    "jszip": "^3.10.2",
    "magic-string": "^0.30.0",
    "nanoid": "^5.0.0",
    "parse5": "^7.2.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.48.0",
    "pngjs": "^7.0.0",
    "polygon-clipping": "0.15.7",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "source-map-js": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "vite": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron/notarize": "2.5.0",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "dugite": "3.3.1",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "eslint": "10.14.0",
    "eslint-plugin-boundaries": "7.4.0",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-tsdoc": "0.5.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-plugin-react-doctor": "0.9.18",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "^4.3.3",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "ultracite": "8.1.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@11.1.1",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "dugite@3.3.1": true
  }
}
