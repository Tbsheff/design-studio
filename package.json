{
  "name": "design-studio",
  "version": "0.6.0",
  "private": true,
  "description": "A local AI design studio: an agent writes HTML and React files on disk, the studio previews and versions them.",
  "license": "Apache-2.0",
  "repository": "github:Tbsheff/design-studio",
  "type": "module",
  "main": "desktop/dist/main.js",
  "scripts": {
    "dev": "concurrently -k -n server,ui \"tsx watch src/server/index.ts\" \"vite --config vite.ui.config.ts\"",
    "start": "vite build --config vite.ui.config.ts && tsx src/server/index.ts",
    "server": "tsx src/server/index.ts",
    "build:ui": "vite build --config vite.ui.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "electron:dev": "tsx scripts/electron-dev.ts",
    "desktop:build": "tsx scripts/electron-dev.ts --build-only",
    "e2e:desktop": "npm run desktop:build && playwright test -c playwright.desktop.config.ts",
    "desktop:stage": "tsx desktop/build.ts",
    "desktop:pack": "tsx scripts/desktop-pack.ts",
    "render:parity": "npm run desktop:build && tsx scripts/render-parity.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.307",
    "@babel/parser": "^7.26.0",
    "@base-ui/react": "^1.9.0",
    "@hono/node-server": "^1.13.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.14.0",
    "chokidar": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "electron-updater": "6.8.9",
    "esbuild": "0.28.2",
    "hono": "^4.6.0",
    "magic-string": "^0.30.0",
    "nanoid": "^5.0.0",
    "parse5": "^7.2.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.48.0",
    "pngjs": "^7.0.0",
    "polygon-clipping": "0.15.7",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "source-map-js": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "vite": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron/notarize": "2.5.0",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "dugite": "3.3.1",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "dugite@3.3.1": true
  }
}
