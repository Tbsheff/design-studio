{
  "name": "design-studio-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @design-studio/desktop run dev",
    "start": "pnpm --filter @design-studio/desktop run start",
    "server": "pnpm --filter @design-studio/desktop run server",
    "build:ui": "pnpm --filter @design-studio/desktop run build:ui",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:tsrs": "pnpm --filter @design-studio/desktop run typecheck:tsrs",
    "lint": "pnpm --filter @design-studio/desktop run lint",
    "lint:gate": "pnpm --filter @design-studio/desktop run lint:gate",
    "check": "pnpm --filter @design-studio/desktop run check",
    "check:scripts": "pnpm --filter @design-studio/desktop run check:scripts",
    "gen:routes": "pnpm --filter @design-studio/desktop run gen:routes",
    "format": "pnpm --filter @design-studio/desktop run format",
    "e2e": "pnpm --filter @design-studio/desktop run e2e",
    "electron:dev": "pnpm --filter @design-studio/desktop run electron:dev",
    "check:final": "pnpm run typecheck && pnpm run lint:gate && pnpm --filter @design-studio/desktop run lint:boundaries"
  },
  "devDependencies": {
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "ultracite": "8.1.0"
  },
  "packageManager": "pnpm@11.1.1",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "dugite@3.3.1": true
  }
}
