#!/bin/sh
set -e
lint_globs="*.ts *.tsx *.js *.mjs *.cjs"
fmt_globs="*.ts *.tsx *.css *.json"
staged() {
  set -f
  git diff --cached --name-only --diff-filter=ACMR -z -- $1
  set +f
}
if [ -n "$(staged "$lint_globs" | tr -d '\0')" ]; then
  staged "$lint_globs" | xargs -0 node_modules/.bin/oxlint --
fi
if [ -n "$(staged "$fmt_globs" | tr -d '\0')" ]; then
  staged "$fmt_globs" | xargs -0 node_modules/.bin/oxfmt --check --no-error-on-unmatched-pattern --
fi
npm run --silent lint:boundaries
