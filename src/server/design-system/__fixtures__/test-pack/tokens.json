{
  "$description": "Test pack tokens.",
  "color": {
    "$type": "color",
    "bg": {
      "$value": "#ffffff",
      "$description": "Page background.",
      "$extensions": {
        "studio.modes": {
          "dark": "#111111"
        }
      }
    },
    "surface": {
      "$value": "oklch(98% 0.005 250)",
      "$extensions": {
        "studio.modes": {
          "dark": "oklch(22% 0.01 250)"
        }
      }
    },
    "fg": {
      "$value": "rgb(20, 20, 30)",
      "$description": "Body text.",
      "$extensions": {
        "studio.modes": {
          "dark": "#f5f5f5"
        }
      }
    },
    "fg-muted": {
      "$value": "hsl(220 10% 40%)",
      "$extensions": {
        "studio.modes": {
          "dark": "hsl(220 10% 70%)"
        }
      }
    },
    "border": {
      "$value": "#e2e2e8",
      "$extensions": {
        "studio.modes": {
          "dark": "#333340"
        }
      }
    },
    "primary": {
      "$value": "oklch(55% 0.2 260)",
      "$description": "Primary actions.",
      "$extensions": {
        "studio.modes": {
          "dark": "oklch(70% 0.15 260)"
        }
      }
    },
    "primary-fg": {
      "$value": "#ffffff"
    },
    "accent": {
      "$value": "oklch(70% 0.15 60)"
    },
    "accent-fg": {
      "$value": "#1a1a1a"
    },
    "success": {
      "$value": "#1f8a4c"
    },
    "warning": {
      "$value": "#b26a00"
    },
    "danger": {
      "$value": "#c62828"
    },
    "ring": {
      "$value": "{color.primary}",
      "$description": "Focus ring."
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": "\"Inter\", system-ui, sans-serif"
    },
    "body": {
      "$value": "\"Inter\", system-ui, sans-serif"
    },
    "mono": {
      "$value": "\"JetBrains Mono\", ui-monospace, monospace"
    }
  },
  "text": {
    "$type": "dimension",
    "xs": {
      "$value": "0.75rem"
    },
    "sm": {
      "$value": "0.875rem"
    },
    "base": {
      "$value": "1rem"
    },
    "lg": {
      "$value": "1.125rem"
    },
    "xl": {
      "$value": "1.25rem"
    },
    "2xl": {
      "$value": "1.5rem"
    },
    "3xl": {
      "$value": "1.875rem"
    },
    "4xl": {
      "$value": "2.25rem"
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "5": {
      "$value": "20px"
    },
    "6": {
      "$value": "24px"
    },
    "8": {
      "$value": "32px"
    },
    "10": {
      "$value": "40px"
    },
    "12": {
      "$value": "48px"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "4px"
    },
    "md": {
      "$value": "8px"
    },
    "lg": {
      "$value": "12px"
    },
    "pill": {
      "$value": "999px"
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": "0 1px 2px oklch(0% 0 0 / 0.08)"
    },
    "md": {
      "$value": "0 4px 12px oklch(0% 0 0 / 0.1)"
    },
    "lg": {
      "$value": "0 12px 32px oklch(0% 0 0 / 0.14)"
    }
  }
}
