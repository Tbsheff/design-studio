{
  "$description": "Brutalist starter pack tokens.",
  "color": {
    "$type": "color",
    "$description": "Light palette in OKLCH; each token carries its dark value in $extensions.studio.modes.dark.",
    "bg": {
      "$value": "oklch(99% 0 0)",
      "$description": "Page background.",
      "$extensions": {
        "studio.modes": {
          "dark": "oklch(13% 0 0)"
        }
      }
    },
    "surface": {
      "$value": "oklch(100% 0 0)",
      "$description": "Cards, panels, inputs, raised areas.",
      "$extensions": {
        "studio.modes": {
          "dark": "oklch(17% 0 0)"
        }
      }
    },
    "fg": {
      "$value": "oklch(13% 0 0)",
      "$description": "Body text and headings.",
      "$extensions": {
        "studio.modes": {
          "dark": "oklch(98% 0 0)"
        }
      }
    },
    "fg-muted": {
      "$value": "oklch(38% 0 0)",
      "$description": "Secondary text, captions, placeholders.",
      "$extensions": {
        "studio.modes": {
          "dark": "oklch(78% 0 0)"
        }
      }
    },
    "border": {
      "$value": "oklch(13% 0 0)",
      "$description": "Dividers, input and card outlines.",
      "$extensions": {
        "studio.modes": {
          "dark": "oklch(98% 0 0)"
        }
      }
    },
    "primary": {
      "$value": "oklch(91% 0.18 104)",
      "$description": "Main action fill: one filled button per view, active nav block. Never text on bg; links are fg with a thick underline.",
      "$extensions": {
        "studio.modes": {
          "dark": "oklch(91% 0.18 104)"
        }
      }
    },
    "primary-fg": {
      "$value": "oklch(13% 0 0)",
      "$description": "Text and icons on primary.",
      "$extensions": {
        "studio.modes": {
          "dark": "oklch(13% 0 0)"
        }
      }
    },
    "accent": {
      "$value": "oklch(50% 0.24 264)",
      "$description": "Highlight fill: selected rows, tags, callouts.",
      "$extensions": {
        "studio.modes": {
          "dark": "oklch(70% 0.15 264)"
        }
      }
    },
    "accent-fg": {
      "$value": "oklch(100% 0 0)",
      "$description": "Text and icons on accent.",
      "$extensions": {
        "studio.modes": {
          "dark": "oklch(13% 0 0)"
        }
      }
    },
    "success": {
      "$value": "oklch(52% 0.16 145)",
      "$description": "Positive status icons, fills and borders.",
      "$extensions": {
        "studio.modes": {
          "dark": "oklch(78% 0.18 145)"
        }
      }
    },
    "warning": {
      "$value": "oklch(70% 0.17 55)",
      "$description": "Caution status icons, fills and borders.",
      "$extensions": {
        "studio.modes": {
          "dark": "oklch(80% 0.13 60)"
        }
      }
    },
    "danger": {
      "$value": "oklch(55% 0.22 28)",
      "$description": "Destructive and error status icons, fills and borders.",
      "$extensions": {
        "studio.modes": {
          "dark": "oklch(68% 0.2 28)"
        }
      }
    },
    "ring": {
      "$value": "oklch(50% 0.24 264)",
      "$description": "Focus outline (2px, 2px offset), electric blue.",
      "$extensions": {
        "studio.modes": {
          "dark": "oklch(70% 0.15 264)"
        }
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": "'Archivo', 'Arial Black', 'Helvetica Neue', Arial, sans-serif"
    },
    "body": {
      "$value": "'Archivo', 'Helvetica Neue', Arial, sans-serif"
    },
    "mono": {
      "$value": "'Space Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace"
    }
  },
  "text": {
    "$type": "dimension",
    "$description": "Modular scale: base 1rem, ratio 1.5 (perfect fifth) upward; ratio 1.125 below base to keep small text legible.",
    "xs": {
      "$value": "0.79rem"
    },
    "sm": {
      "$value": "0.889rem"
    },
    "base": {
      "$value": "1rem"
    },
    "lg": {
      "$value": "1.5rem"
    },
    "xl": {
      "$value": "2.25rem"
    },
    "2xl": {
      "$value": "3.375rem"
    },
    "3xl": {
      "$value": "5.063rem"
    },
    "4xl": {
      "$value": "7.594rem"
    }
  },
  "space": {
    "1": {
      "$value": "0.25rem"
    },
    "2": {
      "$value": "0.5rem"
    },
    "3": {
      "$value": "0.75rem"
    },
    "4": {
      "$value": "1rem"
    },
    "5": {
      "$value": "1.25rem"
    },
    "6": {
      "$value": "1.5rem"
    },
    "8": {
      "$value": "2rem"
    },
    "10": {
      "$value": "2.5rem"
    },
    "12": {
      "$value": "3rem"
    },
    "16": {
      "$value": "4rem"
    },
    "20": {
      "$value": "5rem"
    },
    "24": {
      "$value": "6rem"
    },
    "$type": "dimension",
    "$description": "4px base grid (n x 0.25rem)."
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "0px"
    },
    "md": {
      "$value": "0px"
    },
    "lg": {
      "$value": "0px"
    },
    "pill": {
      "$value": "0px"
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Hard offset shadows, no blur. Light mode: black offset. Dark mode: white offset on black.",
    "sm": {
      "$value": "3px 3px 0 0 oklch(13% 0 0)",
      "$extensions": {
        "studio.modes": {
          "dark": "3px 3px 0 0 oklch(98% 0 0)"
        }
      }
    },
    "md": {
      "$value": "5px 5px 0 0 oklch(13% 0 0)",
      "$extensions": {
        "studio.modes": {
          "dark": "5px 5px 0 0 oklch(98% 0 0)"
        }
      }
    },
    "lg": {
      "$value": "8px 8px 0 0 oklch(13% 0 0)",
      "$extensions": {
        "studio.modes": {
          "dark": "8px 8px 0 0 oklch(98% 0 0)"
        }
      }
    }
  }
