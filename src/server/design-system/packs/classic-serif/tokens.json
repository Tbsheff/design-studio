    "$type": "dimension",
    "sm": {
      "$value": "2px"
    },
    "md": {
      "$value": "3px"
    },
    "lg": {
      "$value": "4px"
    },
    "pill": {
      "$value": "9999px"
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Shadows tinted with the palette hue, never pure black. Dark mode uses deeper, more opaque shadows.",
    "sm": {
      "$value": "0 1px 2px oklch(25% 0.04 262 / 0.08), 0 1px 1px oklch(25% 0.04 262 / 0.05)",
      "$extensions": {
        "studio.modes": {
          "dark": "0 1px 2px oklch(5% 0.01 262 / 0.5)"
        }
      }
    },
