{
  "$description": "Classic Serif starter pack tokens.",
  "color": {
    "$type": "color",
    "$description": "Light palette in OKLCH; each token carries its dark value in $extensions.studio.modes.dark.",
    "bg": {
      "$value": "oklch(96% 0.02 90)",
      "$description": "Page background.",
      "$extensions": {
        "studio.modes": {
          "dark": "oklch(17% 0.025 260)"
        }
      }
    },
    "surface": {
      "$value": "oklch(98.5% 0.012 90)",
