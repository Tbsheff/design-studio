  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": "'Geist', 'Helvetica Neue', Arial, system-ui, sans-serif"
    },
    "body": {
      "$value": "'Geist', 'Helvetica Neue', Arial, system-ui, sans-serif"
    },
    "mono": {
      "$value": "'Geist Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace"
    }
  },
  "text": {
    "$type": "dimension",
    "$description": "Modular scale: base 1rem, ratio 1.25 (major third) upward; ratio 1.125 below base to keep small text legible.",
    "xs": {
      "$value": "0.79rem"
    },
    "sm": {
      "$value": "0.889rem"
    },
    "base": {
      "$value": "1rem"
    },
    "lg": {
      "$value": "1.25rem"
    },
    "xl": {
      "$value": "1.563rem"
    },
    "2xl": {
      "$value": "1.953rem"
    },
    "3xl": {
      "$value": "2.441rem"
    },
    "4xl": {
      "$value": "3.052rem"
    }
  },
  "space": {
    "1": {
      "$value": "0.25rem"
    },
    "2": {
      "$value": "0.5rem"
    },
    "3": {
      "$value": "0.75rem"
    },
    "4": {
      "$value": "1rem"
    },
    "5": {
      "$value": "1.25rem"
    },
    "6": {
      "$value": "1.5rem"
    },
    "8": {
      "$value": "2rem"
    },
    "10": {
      "$value": "2.5rem"
    },
    "12": {
      "$value": "3rem"
    },
    "16": {
      "$value": "4rem"
    },
    "20": {
      "$value": "5rem"
    },
    "24": {
      "$value": "6rem"
    },
    "$type": "dimension",
    "$description": "4px base grid (n x 0.25rem)."
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "4px"
    },
    "md": {
      "$value": "8px"
    },
    "lg": {
      "$value": "12px"
    },
    "pill": {
      "$value": "9999px"
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Shadows tinted with the palette hue, never pure black. Dark mode uses deeper, more opaque shadows.",
    "sm": {
      "$value": "0 1px 2px oklch(25% 0.01 200 / 0.08), 0 1px 1px oklch(25% 0.01 200 / 0.05)",
      "$extensions": {
        "studio.modes": {
          "dark": "0 1px 2px oklch(5% 0.01 200 / 0.5)"
        }
      }
    },
    "md": {
      "$value": "0 4px 12px -2px oklch(25% 0.01 200 / 0.12), 0 2px 4px -1px oklch(25% 0.01 200 / 0.06)",
      "$extensions": {
        "studio.modes": {
          "dark": "0 4px 12px -2px oklch(5% 0.01 200 / 0.6), 0 2px 4px -1px oklch(5% 0.01 200 / 0.4)"
        }
      }
    },
    "lg": {
      "$value": "0 18px 40px -12px oklch(25% 0.01 200 / 0.18), 0 6px 12px -4px oklch(25% 0.01 200 / 0.08)",
      "$extensions": {
        "studio.modes": {
          "dark": "0 18px 40px -12px oklch(5% 0.01 200 / 0.7), 0 6px 12px -4px oklch(5% 0.01 200 / 0.5)"
        }
      }
    }
  }
