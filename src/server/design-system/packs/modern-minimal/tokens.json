{
  "$description": "Modern Minimal starter pack tokens.",
  "color": {
    "$type": "color",
    "$description": "Light palette in OKLCH; each token carries its dark value in $extensions.studio.modes.dark.",
    "bg": {
      "$value": "oklch(99.2% 0 0)",
      "$description": "Page background.",
      "$extensions": {
        "studio.modes": {
          "dark": "oklch(16% 0.003 200)"
        }
      }
    },
    "surface": {
      "$value": "oklch(97.4% 0.002 200)",
      "$description": "Cards, panels, inputs, raised areas.",
      "$extensions": {
        "studio.modes": {
          "dark": "oklch(19.5% 0.004 200)"
        }
      }
    },
    "fg": {
      "$value": "oklch(18% 0.004 200)",
      "$description": "Body text and headings.",
      "$extensions": {
        "studio.modes": {
          "dark": "oklch(96% 0.002 200)"
        }
      }
    },
    "fg-muted": {
