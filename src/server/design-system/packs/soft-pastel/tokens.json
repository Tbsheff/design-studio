  "shadow": {
    "$type": "shadow",
    "$description": "Shadows tinted with the palette hue, never pure black. Dark mode uses deeper, more opaque shadows.",
    "sm": {
      "$value": "0 1px 2px oklch(45% 0.06 320 / 0.08), 0 1px 1px oklch(45% 0.06 320 / 0.05)",
