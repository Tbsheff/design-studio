{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [],
    "noEmit": true
  },
  "include": [
    "desktop/first-run-page.renderer.ts",
    "desktop/render-pool.renderer.ts",
    "desktop/window.renderer.ts"
  ]
}
