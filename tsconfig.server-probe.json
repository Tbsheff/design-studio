{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src/server/agent-tools/sdk-shape.ts",
    "src/server/canvas/links/link-tools.ts",
    "src/server/components/preview-bundle.ts",
    "src/server/components/preview.ts",
    "src/server/design-rules/probe.ts",
    "src/server/design-system/extract/browser-collect.ts",
    "src/server/direct-edit/commit/arrange-probe.ts",
    "src/server/direct-edit/commit/style-scan.ts",
    "src/server/export/copy-code.ts",
    "src/server/export/inline-html.ts",
    "src/server/export/page-scan.ts",
    "src/server/export/pptx-xml.ts",
    "src/server/export/vector-export.ts",
    "src/server/export/vector.ts",
    "src/server/gallery/engine/page.ts",
    "src/server/gallery/engine/probe.ts",
    "src/server/mcp/registry.ts",
    "src/server/mcp/select-tools.ts",
    "src/server/page-import/capture.ts",
    "src/server/page-import/collect-script.ts",
    "src/server/page-probe/element.ts",
    "src/server/page-probe/layer-ref.ts",
    "src/server/page-probe/lock-probe.ts",
    "src/server/page-probe/owner-probe.ts",
    "src/server/platform/process/worker-client.ts",
    "src/server/preview/annotate.ts",
    "src/server/preview/browser.ts",
    "src/server/preview/capture.ts",
    "src/server/preview/frame-html-read.ts",
    "src/server/preview/peek-pages.ts",
    "src/server/preview/screens-probe.ts",
    "src/server/publish/remote.ts",
    "src/server/review/probe.ts",
    "src/server/review/run.ts",
    "src/server/share/viewer-page.ts",
    "src/server/**/*.probe.ts"
  ]
}
